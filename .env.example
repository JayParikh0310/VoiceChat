# Copy to .env and fill in values.
# This project is fully offline — no API keys required at runtime.
# Only needed if you optionally enable cloud LLM fallback.

# Optional: cloud fallback (not required for offline mode)
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Ollama server (default, change only if running Ollama on another host)
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=INFO
